---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LatestInstagram from '../components/LatestInstagram.astro';
---
<Layout title="Početna">
  <div class="home-container">
    <section class="hero" aria-labelledby="welcome-title">
      <h1 id="welcome-title">Dobrodošli u DDOS</h1>
      <p class="subtitle">Demokratski delegirana organizacija studenata</p>
      <p class="description">Upoznajte se sa našom misijom, aktivnostima i zajednicom. Budite deo nečeg većeg!</p>
      <a href="/uclani-se" class="cta-button">Pridruži nam se</a>
      <SocialLinks />
    </section>
  </div>
  <div class="tekst-container">
    <section class="tekst" aria-labelledby="about-title">
      <h2 id="about-title" class="centered-heading">O NAMA</h2>
      <p class="description">DDOS je Demokratski delegirana organizacija studenata na Elektronskom fakultetu. Ovaj sajt je mesto za informacije o organizaciji, novosti i najave događaja namenjenih studentima.</p>
      <p class="description">Upoznaj našu zajednicu i saznaj kako da nam se pridružiš. <a href="/o-nama">Više o nama</a></p>
    </section>
  </div>
  <div class="home-instagram"><LatestInstagram /></div>
</Layout>
<style>
  #about-title { font-size: 32px; line-height: normal; margin-bottom: 0; }
  .home-instagram { margin-top: 60px; }
  @media (max-width: 768px) { .home-instagram { margin-top: 36px; } }
</style>
